{
    "openapi": "3.0.3",
    "info": {
        "title": "HIdP",
        "version": "1.0.0",
        "description": "Hello, ID Please"
    },
    "paths": {
        "/api/email-change/": {
            "post": {
                "operationId": "email_change_create",
                "tags": [
                    "email-change"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChange"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChange"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChange"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "description": "No response body"
                    }
                }
            },
            "delete": {
                "operationId": "email_change_destroy",
                "tags": [
                    "email-change"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/email-change-confirm/": {
            "put": {
                "operationId": "email_change_confirm_update",
                "description": "Get the existing email change request and update it.\n\nIf the request is complete the email of the user is updated and\nan email to inform the user is sent.\n\nReturns a response containing whether the request is confirmed\nby the current and proposed mail. If both have confirmed the request\nthe change can be considered complete.",
                "tags": [
                    "email-change-confirm"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeConfirm"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeConfirm"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeConfirm"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UpdateChangeEmailRequestResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/email-verification/confirm/": {
            "post": {
                "operationId": "email_verification_confirm_create",
                "description": "Mark the email address as verified. The user still has to log in.",
                "tags": [
                    "email-verification"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationConfirm"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationConfirm"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationConfirm"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/email-verification/resend/": {
            "post": {
                "operationId": "email_verification_resend_create",
                "description": "Resend the verification email to the user this session is waiting for.\n\nAlways responds with 204, so the response does not reveal whether an email\nwas sent.",
                "tags": [
                    "email-verification"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/email-verification/verify/": {
            "post": {
                "operationId": "email_verification_verify_create",
                "description": "Check an email verification token before confirming it.\n\nTells the client whether the confirmation must include a first and last name.",
                "tags": [
                    "email-verification"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationToken"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationToken"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationToken"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmailVerificationVerifyResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/login/": {
            "post": {
                "operationId": "login_create",
                "description": "Log in with a username and password.\n\nResponds with the authentication state. A user whose email address is not\nverified is not logged in, is sent a verification email, and the response has a\npending `email_verify` step.",
                "tags": [
                    "login"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/logout/": {
            "post": {
                "operationId": "logout_create",
                "description": "Logs out the user, regardless of whether a user is logged in.\n\nEnforces that a CSRF token is provided.",
                "tags": [
                    "logout"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/password-reset/": {
            "post": {
                "operationId": "password_reset_create",
                "description": "Email a password reset link, or a set password link to a user without a password.\n\nAlways responds with 204, so the response does not reveal whether an account\nexists.",
                "tags": [
                    "password-reset"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/password-reset/confirm/": {
            "post": {
                "operationId": "password_reset_confirm_create",
                "description": "Set a new password for the user identified by the password reset token.\n\nChanging the password invalidates the user's existing sessions. The user still\nhas to log in.",
                "tags": [
                    "password-reset"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetConfirmation"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetConfirmation"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetConfirmation"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/session/": {
            "get": {
                "operationId": "session_retrieve",
                "description": "Describe the authentication state of the current session.\n\nAlso sets the CSRF cookie, which clients need for every unsafe request.",
                "tags": [
                    "session"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/users/{id}/": {
            "get": {
                "operationId": "users_retrieve",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "me"
                            ]
                        },
                        "description": "Key identifying user, can only have value `me`.",
                        "required": true
                    }
                ],
                "tags": [
                    "users"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "put": {
                "operationId": "users_update",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "me"
                            ]
                        },
                        "description": "Key identifying user, can only have value `me`.",
                        "required": true
                    }
                ],
                "tags": [
                    "users"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "patch": {
                "operationId": "users_partial_update",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "A UUID string identifying this user.",
                        "required": true
                    }
                ],
                "tags": [
                    "users"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUser"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUser"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUser"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AuthState": {
                "type": "object",
                "properties": {
                    "user": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/User"
                            }
                        ],
                        "nullable": true
                    },
                    "pending": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PendingStep"
                        }
                    }
                },
                "required": [
                    "pending",
                    "user"
                ]
            },
            "EmailChange": {
                "type": "object",
                "properties": {
                    "proposed_email": {
                        "type": "string",
                        "format": "email",
                        "writeOnly": true,
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "password",
                    "proposed_email"
                ]
            },
            "EmailChangeConfirm": {
                "type": "object",
                "properties": {
                    "confirmation_token": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "confirmation_token"
                ]
            },
            "EmailVerificationConfirm": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "first_name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "last_name": {
                        "type": "string",
                        "maxLength": 150
                    }
                },
                "required": [
                    "token"
                ]
            },
            "EmailVerificationToken": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "token"
                ]
            },
            "EmailVerificationVerifyResponse": {
                "type": "object",
                "properties": {
                    "requires_name": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "requires_name"
                ]
            },
            "Login": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            },
            "PasswordResetConfirmation": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "uidb64": {
                        "type": "string"
                    },
                    "new_password": {
                        "type": "string"
                    }
                },
                "required": [
                    "new_password",
                    "token",
                    "uidb64"
                ]
            },
            "PasswordResetRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "PatchedUser": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "title": "Email address"
                    }
                }
            },
            "PendingStep": {
                "type": "object",
                "properties": {
                    "step": {
                        "$ref": "#/components/schemas/StepEnum"
                    }
                },
                "required": [
                    "step"
                ]
            },
            "StepEnum": {
                "enum": [
                    "email_verify"
                ],
                "type": "string",
                "description": "* `email_verify` - email_verify"
            },
            "UpdateChangeEmailRequestResponse": {
                "type": "object",
                "properties": {
                    "confirmed_by_current_email": {
                        "type": "boolean"
                    },
                    "confirmed_by_proposed_email": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "confirmed_by_current_email",
                    "confirmed_by_proposed_email"
                ]
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "title": "Email address"
                    }
                },
                "required": [
                    "email",
                    "first_name",
                    "id",
                    "last_name"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            },
            "oauth2": {
                "type": "oauth2",
                "flows": {}
            }
        }
    }
}