{
    "openapi": "3.0.3",
    "info": {
        "title": "HIdP",
        "version": "1.0.0",
        "description": "Hello, ID Please"
    },
    "paths": {
        "/api/email-change/": {
            "get": {
                "operationId": "email_change_retrieve",
                "description": "The pending email change request of the logged-in user.\n\nStarting a new request replaces the pending one.",
                "tags": [
                    "email-change"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmailChange"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "email_change_create",
                "description": "The pending email change request of the logged-in user.\n\nStarting a new request replaces the pending one.",
                "tags": [
                    "email-change"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmailChange"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponse"
                                }
                            }
                        },
                        "description": "`code` says why the user may not do this."
                    }
                }
            },
            "delete": {
                "operationId": "email_change_destroy",
                "description": "The pending email change request of the logged-in user.\n\nStarting a new request replaces the pending one.",
                "tags": [
                    "email-change"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/email-change/confirm/": {
            "post": {
                "operationId": "email_change_confirm_create",
                "description": "Confirm the email change request with the token from one of its emails.\n\nThe email address changes once both the current and proposed address confirm it.",
                "tags": [
                    "email-change"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeConfirm"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeConfirm"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailChangeConfirm"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmailChange"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/email-verification/confirm/": {
            "post": {
                "operationId": "email_verification_confirm_create",
                "description": "Mark the email address as verified. The user still has to log in.",
                "tags": [
                    "email-verification"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationConfirm"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationConfirm"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationConfirm"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/email-verification/resend/": {
            "post": {
                "operationId": "email_verification_resend_create",
                "description": "Resend the verification email to the user this session is waiting for.\n\nAlways responds with 204, so the response does not reveal whether an email\nwas sent.",
                "tags": [
                    "email-verification"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/email-verification/verify/": {
            "post": {
                "operationId": "email_verification_verify_create",
                "description": "Check an email verification token before confirming it.\n\nTells the client whether the confirmation must include a first and last name.",
                "tags": [
                    "email-verification"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationToken"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationToken"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/EmailVerificationToken"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmailVerificationVerifyResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/login/": {
            "post": {
                "operationId": "login_create",
                "description": "Log in with a username and password.\n\nA user whose email address is not verified is sent a verification email instead,\nand the response has a pending `email_verify` step.",
                "tags": [
                    "login"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Login"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/logout/": {
            "post": {
                "operationId": "logout_create",
                "description": "Log out, whether or not a user is logged in.",
                "tags": [
                    "logout"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/password-reset/": {
            "post": {
                "operationId": "password_reset_create",
                "description": "Email a password reset link, or a set password link to a user without a password.\n\nAlways responds with 204, so the response does not reveal whether an account\nexists.",
                "tags": [
                    "password-reset"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/password-reset/confirm/": {
            "post": {
                "operationId": "password_reset_confirm_create",
                "description": "Set a new password for the user identified by the password reset token.\n\nChanging the password invalidates the user's existing sessions. The user still\nhas to log in.",
                "tags": [
                    "password-reset"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetConfirmation"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetConfirmation"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordResetConfirmation"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/password/change/": {
            "post": {
                "operationId": "password_change_create",
                "description": "Change the password of the logged-in user, who must enter the current one.",
                "tags": [
                    "password"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordChange"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordChange"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordChange"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponse"
                                }
                            }
                        },
                        "description": "`code` says why the user may not do this."
                    }
                }
            }
        },
        "/api/password/set/": {
            "post": {
                "operationId": "password_set_create",
                "description": "Set a password for a logged-in user who does not have one.\n\nOnly allowed shortly after logging in, to prove the user's identity.",
                "tags": [
                    "password"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SetPassword"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/SetPassword"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/SetPassword"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponse"
                                }
                            }
                        },
                        "description": "`code` says why the user may not do this."
                    }
                }
            }
        },
        "/api/session/": {
            "get": {
                "operationId": "session_retrieve",
                "description": "Describe the authentication state of the current session.\n\nAlso sets the CSRF cookie, which clients need for every unsafe request.",
                "tags": [
                    "session"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/signup/": {
            "post": {
                "operationId": "signup_create",
                "description": "Create an account, and send the email to verify it.\n\nResponds with a pending `email_verify` step whether or not the account existed.",
                "tags": [
                    "signup"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Signup"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Signup"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Signup"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthState"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/users/me/": {
            "get": {
                "operationId": "users_me_retrieve",
                "description": "The logged-in user.\n\nWith HIdP's OIDC provider installed, an OAuth2 access token with the `profile`\nand `email` scopes can read the user too, but not change it.",
                "tags": [
                    "users"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "patch": {
                "operationId": "users_me_partial_update",
                "description": "The logged-in user.\n\nWith HIdP's OIDC provider installed, an OAuth2 access token with the `profile`\nand `email` scopes can read the user too, but not change it.",
                "tags": [
                    "users"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUser"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUser"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedUser"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AuthState": {
                "type": "object",
                "properties": {
                    "user": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/User"
                            }
                        ],
                        "nullable": true
                    },
                    "pending": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PendingStep"
                        }
                    }
                },
                "required": [
                    "pending",
                    "user"
                ]
            },
            "EmailChange": {
                "type": "object",
                "properties": {
                    "current_email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "title": "Current email address"
                    },
                    "proposed_email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "title": "Proposed email address"
                    },
                    "confirmed_by_current_email": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "confirmed_by_proposed_email": {
                        "type": "boolean",
                        "readOnly": true
                    }
                },
                "required": [
                    "confirmed_by_current_email",
                    "confirmed_by_proposed_email",
                    "current_email",
                    "proposed_email"
                ]
            },
            "EmailChangeConfirm": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "token"
                ]
            },
            "EmailChangeRequest": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "proposed_email": {
                        "type": "string",
                        "format": "email",
                        "writeOnly": true
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "password",
                    "proposed_email"
                ]
            },
            "EmailVerificationConfirm": {
                "type": "object",
                "description": "Confirm the email address, with a name when the user does not have one yet.",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "first_name": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "last_name": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "token"
                ]
            },
            "EmailVerificationToken": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "token"
                ]
            },
            "EmailVerificationVerifyResponse": {
                "type": "object",
                "properties": {
                    "requires_name": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "requires_name"
                ]
            },
            "ForbiddenResponse": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "detail"
                ]
            },
            "Login": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "username": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            },
            "PasswordChange": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "old_password": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "new_password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "new_password",
                    "old_password"
                ]
            },
            "PasswordResetConfirmation": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "token": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "uidb64": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "new_password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "new_password",
                    "token",
                    "uidb64"
                ]
            },
            "PasswordResetRequest": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "writeOnly": true
                    }
                },
                "required": [
                    "email"
                ]
            },
            "PatchedUser": {
                "type": "object",
                "description": "The user in the authentication state, and at `/users/me/`.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "first_name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "last_name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true,
                        "title": "Email address",
                        "maxLength": 254
                    },
                    "has_usable_password": {
                        "type": "boolean",
                        "readOnly": true
                    }
                }
            },
            "PendingStep": {
                "type": "object",
                "properties": {
                    "step": {
                        "$ref": "#/components/schemas/StepEnum"
                    }
                },
                "required": [
                    "step"
                ]
            },
            "SetPassword": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "new_password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "new_password"
                ]
            },
            "Signup": {
                "type": "object",
                "description": "Validate the request data with a Django form, after the serializer fields.\n\nThe form's errors become DRF errors, and the valid form is kept as `form`.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "writeOnly": true
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true
                    },
                    "agreed_to_tos": {
                        "type": "boolean",
                        "writeOnly": true
                    }
                },
                "required": [
                    "agreed_to_tos",
                    "email",
                    "password"
                ]
            },
            "StepEnum": {
                "enum": [
                    "email_verify"
                ],
                "type": "string",
                "description": "* `email_verify` - email_verify"
            },
            "User": {
                "type": "object",
                "description": "The user in the authentication state, and at `/users/me/`.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "first_name": {
                        "type": "string",
                        "maxLength": 150
                    },
                    "last_name": {
